# Copy this file to .env and fill in your values. .env is gitignored.
#
# Google Analytics 4 Measurement ID (looks like G-XXXXXXXXXX).
# Note: this ID is public — it ships in the page HTML to every visitor — so
# .env only keeps it out of source control, it is not a secret. Leave it
# empty (or omit .env entirely) to disable analytics, e.g. for local dev.
GA_MEASUREMENT_ID=
